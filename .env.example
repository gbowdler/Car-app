# Required - Anthropic API key, kept server-side only (never exposed to the browser).
ANTHROPIC_API_KEY=

# Optional - overrides the default model (claude-sonnet-4-6).
ANTHROPIC_MODEL=

# Optional but recommended - a passphrase the app must send to use the relay.
# Protects your Anthropic billing and Gmail access if the deployed URL leaks.
# Pick any random string; you'll be prompted to enter the same value once in the app.
ASSISTANT_SHARED_SECRET=

# Optional - only needed for the create_email_draft tool (real Gmail drafts).
# See README.md "Gmail draft setup" for how to obtain these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
